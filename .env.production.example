# Copy to .env.production on the VM. Never commit the populated file.
INLUMEN_PUBLIC_URL=https://inlumen.example.com

# PostgreSQL
POSTGRES_DB=inlumen
POSTGRES_USER=inlumen
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Private service credentials (use different random values).
INLUMEN_CODEGEN_SERVICE_API_KEY=replace-with-a-random-codegen-key
INLUMEN_RUNNER_SERVICE_API_KEY=replace-with-a-random-runner-key
NEO4J_AUTH=neo4j/replace-with-a-long-random-password
MINIO_ROOT_USER=inlumen-storage
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password

# Generate once with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INLUMEN_SECRET_ENCRYPTION_KEY=replace-with-a-fernet-key

# Configure the shared LLM in Settings > Manage shared LLM using an admin account.

# Existing Keycloak realm and public PKCE frontend client.
KEYCLOAK_ISSUER=https://identity.example.com/realms/inlumen
KEYCLOAK_JWKS_URL=https://identity.example.com/realms/inlumen/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=inlumen-frontend
# Small JWT clock tolerance (0-60 seconds); does not replace host NTP.
KEYCLOAK_CLOCK_SKEW_SECONDS=5
VITE_KEYCLOAK_URL=https://identity.example.com
VITE_KEYCLOAK_REALM=inlumen
VITE_KEYCLOAK_CLIENT_ID=inlumen-frontend

# Cloudflare Tunnel. Configure its public hostname to http://inlumen-frontend:8080.
# Start a connector from this Compose file:
COMPOSE_PROFILES=standalone-tunnel
# To reuse an existing connector instead: leave COMPOSE_PROFILES empty, set
# INLUMEN_TUNNEL_NETWORK to its Docker network, and set
# INLUMEN_TUNNEL_NETWORK_EXTERNAL=true. No tunnel token is needed in that mode.
# INLUMEN_PRIVATE_NETWORK=datapact_network
CLOUDFLARE_TUNNEL_TOKEN=replace-with-the-tunnel-token

# Infrastructure defaults in docker-compose-prod.yml use immutable digests.
# Override only with a digest validated in staging, for example:
# POSTGRES_IMAGE=postgres:17-alpine@sha256:...
# NEO4J_IMAGE=neo4j:5-community@sha256:...
# MINIO_IMAGE=minio/minio@sha256:...
# CLOUDFLARED_IMAGE=cloudflare/cloudflared@sha256:...

# Per-workspace and whole-VM queue limits.
# For the 20-user chat trial, start with 2 workers x 16 threads and measure.
# Defaults remain 2 x 4. These are request threads, not codegen/runner job limits.
# INLUMEN_WEB_WORKERS=2
# INLUMEN_WEB_THREADS=16
RUNNER_MAX_OUTSTANDING_RUNS=4
RUNNER_MAX_GLOBAL_OUTSTANDING_RUNS=20

CODEGEN_MAX_OUTSTANDING_RUNS=4
CODEGEN_MAX_GLOBAL_OUTSTANDING_RUNS=12
