# Copy to .env.production on the VM. Never commit the populated file.
INLUMEN_PUBLIC_URL=https://inlumen.example.com

# PostgreSQL
POSTGRES_DB=inlumen
POSTGRES_USER=inlumen
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Private service credentials (use different random values).
INLUMEN_CODEGEN_SERVICE_API_KEY=replace-with-a-random-codegen-key
INLUMEN_RUNNER_SERVICE_API_KEY=replace-with-a-random-runner-key
NEO4J_AUTH=neo4j/replace-with-a-long-random-password
MINIO_ROOT_USER=inlumen-storage
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password

# Generate once with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INLUMEN_SECRET_ENCRYPTION_KEY=replace-with-a-fernet-key

# Existing Keycloak realm and public PKCE frontend client.
KEYCLOAK_ISSUER=https://identity.example.com/realms/inlumen
KEYCLOAK_JWKS_URL=https://identity.example.com/realms/inlumen/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=inlumen-frontend
VITE_KEYCLOAK_URL=https://identity.example.com
VITE_KEYCLOAK_REALM=inlumen
VITE_KEYCLOAK_CLIENT_ID=inlumen-frontend

# Cloudflare Tunnel. Configure its public hostname to http://frontend:8080.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-the-tunnel-token

# Pin these to tested immutable tags or digests before deployment.
POSTGRES_IMAGE=postgres:17-alpine
NEO4J_IMAGE=neo4j:5-community
MINIO_IMAGE=minio/minio:latest
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest

# Per-workspace and whole-VM queue limits.
RUNNER_MAX_OUTSTANDING_RUNS=4
RUNNER_MAX_GLOBAL_OUTSTANDING_RUNS=20
