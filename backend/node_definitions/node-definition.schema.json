{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inlumen.local/schemas/node-definition.schema.json",
  "title": "inLUMEN Node Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "base_type",
    "family",
    "palette",
    "editor",
    "runtime"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_.-]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "base_type": {
      "description": "Stable structural pipeline kind. Templates and runtime implementations are separate metadata.",
      "enum": [
        "source",
        "task",
        "destination",
        "flow",
        "subpipeline"
      ]
    },
    "family": {
      "description": "Palette grouping used to organize related node roles.",
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "description",
        "icon",
        "color"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "icon": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "default": 0
        }
      }
    },
    "editor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "catalog": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runtime": {
      "description": "Implementation-generation metadata, independent of the node's pipeline role.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generator"
      ],
      "properties": {
        "generator": {
          "type": "string",
          "minLength": 1
        },
        "template": {
          "type": "string",
          "minLength": 1
        },
        "base_image": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "default_implementation": {
      "type": "object",
      "default": {}
    }
  }
}
