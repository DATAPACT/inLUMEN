FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS build

WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .

ARG VITE_INLUMEN_API_URL
ARG VITE_AUTH_ENABLED=true
ARG VITE_KEYCLOAK_URL
ARG VITE_KEYCLOAK_REALM=inlumen
ARG VITE_KEYCLOAK_CLIENT_ID=inlumen-frontend
ENV VITE_INLUMEN_API_URL=$VITE_INLUMEN_API_URL
ENV VITE_AUTH_ENABLED=$VITE_AUTH_ENABLED
ENV VITE_KEYCLOAK_URL=$VITE_KEYCLOAK_URL
ENV VITE_KEYCLOAK_REALM=$VITE_KEYCLOAK_REALM
ENV VITE_KEYCLOAK_CLIENT_ID=$VITE_KEYCLOAK_CLIENT_ID
RUN npm run build

FROM nginx:stable-alpine@sha256:dc5069ad14f19660b141b21236140b91656bf89bbc3e2417c70ae650cd66104c
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
