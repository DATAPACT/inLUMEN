# Minimal configuration for development or a single-VM Docker Compose
# deployment behind a TLS reverse proxy such as Cloudflare.

# The normal development Compose stack uses PostgreSQL while keeping auth off.
POSTGRES_DB=inlumen
POSTGRES_USER=inlumen
POSTGRES_PASSWORD=inlumen

# Public URL used by the browser to reach the inLUMEN backend.
INLUMEN_API_PUBLIC_URL=https://api.inlumen.example.com

# Replace these with three different long, random values.
API_AUTH_TOKEN=replace-with-a-long-random-token
INLUMEN_CODEGEN_SERVICE_API_KEY=replace-with-a-different-long-random-token
INLUMEN_RUNNER_SERVICE_API_KEY=replace-with-a-third-long-random-token

# Dagster runs are delegated to the private codegen execution service and run
# in constrained one-off containers. Increase the timeout for long pipelines.
# RUNNER_ADAPTER=dagster
# RUNNER_DAGSTER_TIMEOUT_SECONDS=1800

# One auth setting for both the gateway and browser: false = shared local
# workspace, true = Keycloak login. Development can switch freely; each mode
# keeps its own workspaces. No other auth-mode variables are needed.
AUTH_ENABLED=false

# Keycloak authentication. Uncomment this block and set AUTH_ENABLED=true.
# KEYCLOAK_JWKS_URL=https://identity.example.com/realms/inlumen/protocol/openid-connect/certs
# KEYCLOAK_ISSUER=https://identity.example.com/realms/inlumen
# KEYCLOAK_AUDIENCE=inlumen
# JWT clock tolerance in seconds (0-60); synchronize both hosts with NTP.
KEYCLOAK_CLOCK_SKEW_SECONDS=5
# VITE_KEYCLOAK_URL=https://identity.example.com
# VITE_KEYCLOAK_REALM=inlumen
# VITE_KEYCLOAK_CLIENT_ID=inlumen-frontend

# Optional published-port overrides used by both development and production.
# FRONTEND_PORT=8080
# INLUMEN_API_PORT=5000

# Optional development-only inspection ports. Production keeps these services
# private on the Compose network.
# NEO4J_HTTP_PORT=7474
# NEO4J_BOLT_PORT=7687
# MINIO_S3_PORT=9000
# MINIO_CONSOLE_PORT=9099

# Configure the shared LLM in Settings > Manage shared LLM using an admin account.

# Authenticated generation stages exact file bytes before background execution.
# Per file (raw bytes) and total (base64 bytes, including repeated descriptors).
INLUMEN_CODEGEN_INPUT_MAX_BYTES=52428800
INLUMEN_CODEGEN_INPUT_TOTAL_MAX_BYTES=104857600
# Keep this at least as large as INLUMEN_CODEGEN_INPUT_MAX_BYTES.
CODEGEN_INPUT_FILE_MAX_BYTES=52428800
