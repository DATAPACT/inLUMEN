{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inlumen:schema:artifact-contract:2",
  "title": "inLUMEN Artifact Directory Contract",
  "type": "object",
  "required": [
    "schema_version",
    "transport",
    "input_environment",
    "output_environment",
    "recursive",
    "input_layout",
    "output_layout",
    "port_namespaced",
    "run_isolation",
    "source_agnostic",
    "connector_agnostic"
  ],
  "properties": {
    "schema_version": { "const": "inlumen.artifact-contract@2" },
    "transport": { "const": "filesystem" },
    "input_environment": { "const": "PIPELINE_INPUT_DIR" },
    "output_environment": { "const": "PIPELINE_OUTPUT_DIR" },
    "recursive": { "const": true },
    "input_layout": { "const": "<artifact-relative-path>" },
    "output_layout": { "const": "<artifact-relative-path>" },
    "port_namespaced": { "const": false },
    "run_isolation": { "const": "<run_id>" },
    "source_agnostic": { "const": true },
    "connector_agnostic": { "const": true }
  },
  "additionalProperties": true
}
